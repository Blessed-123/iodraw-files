        <mxCell id="HYAzZhG7RNsZK3y5gQgT-58" value="对每个已接受时间步计算 \(F(t^n)\) 和 \(F(t^{n+1})\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1045" y="2408" width="375" height="52" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-59" value="若 \(F(t^n)\geq0\) 且 \(F(t^{n+1})&amp;lt;0\)，则在区间 \([t^n,t^{n+1}]\) 内进行二分" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1020" y="2460" width="160" height="149.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-60" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;固定左端状态和 BDF2 历史&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1215" y="2469.5" width="235" height="40" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-61" value="重复二分直至区间宽度不超过 \(0.1\ \mathrm{s}\)，取最终右端时刻作为烘干终点" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1070" y="2620" width="337.75" height="49.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-62" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;取中点重新求解 \(T_{\mathrm{mid}}\)、\(C_{\mathrm{mid}}\) 和 \(F(t_{\mathrm{mid}})\)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1222.75" y="2510" width="227.25" height="60" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-63" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;根据其符号更新左右区间&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1215" y="2570" width="235" height="40.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-67" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=20;fontStyle=1" edge="1" parent="1" source="HYAzZhG7RNsZK3y5gQgT-59" target="HYAzZhG7RNsZK3y5gQgT-60">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1320" y="2569.5" as="sourcePoint" />
            <mxPoint x="1370" y="2519.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-68" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fontSize=20;fontStyle=1" edge="1" parent="1" source="HYAzZhG7RNsZK3y5gQgT-59">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1320" y="2569.5" as="sourcePoint" />
            <mxPoint x="1230" y="2539.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-69" value="" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=20;fontStyle=1" edge="1" parent="1" source="HYAzZhG7RNsZK3y5gQgT-59" target="HYAzZhG7RNsZK3y5gQgT-63">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1320" y="2569.5" as="sourcePoint" />
            <mxPoint x="1370" y="2519.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-70" value="确定烘干终点后，每 \(60\ \mathrm{s}\) 记录各径向节点的水分浓度" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="513.49" y="2420" width="376.51" height="49.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-71" value="将结果映射到 0–2 cm、每隔 0.1 cm 的径向位置" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="523.75" y="2560" width="366.25" height="50.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-72" value="对规定输出时刻 t_out∈[tⁿ,tⁿ⁺¹]，按 θ=(t_out−tⁿ)/(tⁿ⁺¹−tⁿ) 对温度和水分浓度进行线性插值" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="510" y="2480" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-73" value="若 5 天内 F(t) 始终未变为负，应明确报告未达标" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="517.5" y="2619.5" width="365" height="50" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-79" value="全域达标与终点定位" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1066.56" y="3270" width="339.5" height="40" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-81" value="附件 2 给出随时间收缩的 R(t)，若直接在物理坐标中固定网格，会产生移动边界和网格重构问题" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="532.5" y="2990" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-82" value="令 ξ=r/R(t)，将计算域固定为 ξ∈[0,1]，中心始终对应 ξ=0，表面始终对应 ξ=1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="532.5" y="3100" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-83" value="在归一化物质坐标中建立收缩条件下的传热传质模型" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1047.75" y="2968" width="392.25" height="50" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-94" value="有限体积界面导纳由扩散或导热系数、界面面积、网络间距共同确定" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1240" y="3120" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-95" value="物理体积按半径平方收缩，界面面积按半径线性缩放" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1040" y="3120" width="183" height="100" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-96" value="水分浓度场采用径向非稳态扩散模型" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1233.5" y="3025" width="206.5" height="85" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-97" value="温度场采用圆柱坐标下的径向非稳态导热模型" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1037" y="3025" width="183" height="85" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-98" value="ξ 方向取 N=250，几何量按步末 R(tⁿ⁺¹) 更新，界面 D、k 采用调和平均" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1570" y="3334.5" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-99" value="附件 2 的 R(t) 采用 PCHIP，中心为零通量条件，表面采用 Robin 换热与传质条件" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1590" y="3140" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-100" value="附件 1 在 4 h 内采用 PCHIP，4 h 后主模型保持最后一个小时 10800–14400 s 的平均值" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1580" y="3060" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-102" value="检测阈值跨越后使用 advance_to_target 自动细分时间步并局部二分" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1050" y="3390" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-103" value="以 max_ξC(ξ,t)&amp;lt;0.15 kg/kg 为全域达标判据" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1050" y="3320" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-104" value="每个线性子问题由 Thomas 算法求解，Picard 不收敛时减小时间步" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1570" y="3484.5" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-144" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;fontSize=20;strokeWidth=2;endSize=9;fontStyle=1" edge="1" parent="1" source="HYAzZhG7RNsZK3y5gQgT-121" target="HYAzZhG7RNsZK3y5gQgT-122">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-105" value="时间采用首步后向欧拉与变步长 BDF2，层内通过 Picard 迭代处理非线性" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1570" y="3414.5" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-109" value="当时间区间宽度不超过 0.1 s 时，取右端时刻作为烘干终点" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1050" y="3470" width="370" height="74.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-110" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;进一步比较固定半径、界面平均、通量平衡和 Cmax 单调性检验&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="669.25" y="3500" width="260.75" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-111" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;开展网格、时间步、环境延拓、R(t) 插值检验&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="671.25" y="3440" width="258.75" height="50" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-112" value="输出结果" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="547" y="3465" width="92.12" height="90" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-113" value="固定距离满足 r≤R(t) 时按 ξ=r/R(t) 插值，r&amp;gt;R(t) 时结果留空，并另设“药材表面”列" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
