        <mxCell id="vHZNnp70cTp2YP3ywfks-40" value="确认误差收敛检验计算时间范围" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="510" y="1735" width="175" height="80" as="geometry" />
        </mxCell>
        <mxCell id="vHZNnp70cTp2YP3ywfks-46" value="完成Picard收敛后推进时间" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1030" y="1680" width="400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vHZNnp70cTp2YP3ywfks-67" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.529;entryY=-0.028;entryDx=0;entryDy=0;entryPerimeter=0;strokeWidth=2;endSize=9;fontSize=20;fontStyle=1" parent="1" source="vHZNnp70cTp2YP3ywfks-15" target="vHZNnp70cTp2YP3ywfks-29" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1905" y="1530" as="sourcePoint" />
            <mxPoint x="1955" y="1480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-2" value="阈值事件定位" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1058.5" y="2360" width="360" height="40" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=20;fontStyle=1" edge="1" parent="1" source="HYAzZhG7RNsZK3y5gQgT-4" target="HYAzZhG7RNsZK3y5gQgT-5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="670.5" y="2129.5" />
              <mxPoint x="670.5" y="2129.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-4" value="烘干时长求解" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="470" y="2164.5" width="150.5" height="110.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-5" value="首个满足全域水分浓度低于 0.15 kg/kg 的时刻" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="685" y="2164.5" width="219" height="112.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-16" value="进入新时间层后，先根据当前迭代值更新\(\rho\)、\(c_p\)、\(k\) 、\(D\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1582.99" y="2510" width="427.01" height="60" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-17" value="中心用零通量边界，表面为 Robin 换热与传质条件" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1220" y="2200.5" width="227" height="99.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-18" value="空间采用径向有限体积离散" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1030" y="2199.5" width="166" height="100.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-19" value="沿用问题二的变物性双向耦合模型" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1060" y="2090" width="366" height="80" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-31" value="从每个时间层的计算结果中提取全域最大水分浓度" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1530" y="2090" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-32" value="&lt;div style=&quot;font-size: 20px;&quot;&gt;构造达标事件函数&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1543.5" y="2170" width="490" height="55.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-39" value="判断规则：若 F(t)≥0，表示尚未全域达标，若 F(t)&amp;lt;0，表示药材各处均已达标" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1555.99" y="2241.5" width="458.51" height="78" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-43" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;以当前时刻\(T^n\)、\(C^n\)为初值；&lt;/font&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;首步用后向欧拉启动，后续采用变步长 BDF2&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;labelBorderColor=#ffffff;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1582.99" y="2438" width="427.01" height="72" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-55" value="执行Picard迭代，并调用Thomas算法线性求解" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1582.99" y="2570" width="427.01" height="50" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-56" value="Picard 收敛后接受时间步并调整 dt" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1582.99" y="2620" width="427.01" height="50" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-58" value="对每个已接受时间步计算 \(F(t^n)\) 和 \(F(t^{n+1})\)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1030" y="2408" width="410" height="62" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-59" value="若 \(F(t^n)\geq0\) 且 \(F(t^{n+1})&amp;lt;0\)，则在区间 \([t^n,t^{n+1}]\) 内进行二分" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1030" y="2480" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-61" value="重复二分直至区间宽度不超过 \(0.1\ \mathrm{s}\)，取最终右端时刻作为烘干终点" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1030" y="2590" width="410" height="79.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-70" value="确定烘干终点后，每 \(60\ \mathrm{s}\) 记录各径向节点的水分浓度" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="513.49" y="2420" width="376.51" height="60" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-71" value="将结果映射到 0–2 cm、每隔 0.1 cm 的径向位置" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="523.75" y="2580" width="366.25" height="80" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-72" value="对规定输出时刻 t_out∈[tⁿ,tⁿ⁺¹]，按 θ=(t_out−tⁿ)/(tⁿ⁺¹−tⁿ) 对温度和水分浓度进行线性插值" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="510" y="2490" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-79" value="全域达标与终点定位" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1066.56" y="3270" width="339.5" height="40" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-81" value="附件 2 给出随时间收缩的 R(t)，若直接在物理坐标中固定网格，会产生移动边界和网格重构问题" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="532.5" y="2990" width="390" height="100" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-82" value="令 ξ=r/R(t)，将计算域固定为 ξ∈[0,1]，中心始终对应 ξ=0，表面始终对应 ξ=1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="532.5" y="3100" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-83" value="在归一化物质坐标中建立收缩条件下的传热传质模型" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1040" y="2980" width="410" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-96" value="水分浓度场采用径向非稳态扩散模型" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1037" y="3125" width="413" height="85" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-97" value="温度场采用圆柱坐标下的径向非稳态导热模型" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1037" y="3050" width="413" height="80" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-98" value="ξ 方向取 N=250，几何量按步末 R(tⁿ⁺¹) 更新，界面 D、k 采用调和平均" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1570" y="3334.5" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-99" value="附件 2 的 R(t) 采用 PCHIP，中心为零通量条件，表面采用 Robin 换热与传质条件" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1580" y="3130" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-100" value="附件 1 在 4 h 内采用 PCHIP，4 h 后主模型保持最后一个小时 10800–14400 s 的平均值" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1580" y="3040" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-102" value="检测阈值跨越后使用 advance_to_target 自动细分时间步并局部二分" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1050" y="3390" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-103" value="以 max_ξC(ξ,t)&amp;lt;0.15 kg/kg 为全域达标判据" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1050" y="3320" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-104" value="每个线性子问题由 Thomas 算法求解，Picard 不收敛时减小时间步" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1570" y="3484.5" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-144" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;fontSize=20;strokeWidth=2;endSize=9;fontStyle=1" edge="1" parent="1" source="HYAzZhG7RNsZK3y5gQgT-121" target="HYAzZhG7RNsZK3y5gQgT-122">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-105" value="时间采用首步后向欧拉与变步长 BDF2，层内通过 Picard 迭代处理非线性" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1570" y="3414.5" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-109" value="当时间区间宽度不超过 0.1 s 时，取右端时刻作为烘干终点" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1050" y="3470" width="370" height="74.5" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-112" value="输出结果" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="570" y="3490" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-113" value="固定距离满足 r≤R(t) 时按 ξ=r/R(t) 插值，r&amp;gt;R(t) 时结果留空，并另设“药材表面”列" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="530" y="3400" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-114" value="模型采用均匀、等比、径向收缩假设" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="530" y="3320" width="400" height="70" as="geometry" />
        </mxCell>
        <mxCell id="HYAzZhG7RNsZK3y5gQgT-138" value="" style="endArrow=classic;html=1;rounded=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;endSize=9;fontSize=20;fontStyle=1" edge="1" parent="1" source="HYAzZhG7RNsZK3y5gQgT-41" target="HYAzZhG7RNsZK3y5gQgT-57">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1761" y="2340" as="sourcePoint" />
